{
  "expo": {
    "name": "Root.esp",
    "slug": "plant-app",
    "version": "2.5.3",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.rootesp.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FAFBF8"
      },
      "versionCode": 27,
      "permissions": [
        "android.permission.INTERNET"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/icon.png"
    },
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAFBF8"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Root.esp uses your photos for plant and community pictures."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": false
        }
      ]
    ],
    "extra": {}
  }
}
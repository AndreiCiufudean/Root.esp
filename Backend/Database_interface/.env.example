PORT=3000
JWT_SECRET=replace-with-a-long-random-secret-before-running
ODBC_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=(localdb)\MSSQLLocalDB;Database=root_esp;Trusted_Connection=Yes;TrustServerCertificate=Yes;

# Add the web frontend URLs you actually use (comma-separated)
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Hardware endpoints are disabled by default. Do not enable without TLS and device provisioning.
ENABLE_DEVICE_API=false
DEVICE_API_REQUIRE_HTTPS=true

# Optional; never put this secret in Frontend/.env or EXPO_PUBLIC_*
# PLANTNET_API_KEY=your-private-plantnet-key

# Optional OpenAI design ONLY on the backend. Do not commit your live key.
# OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_VISION_MODEL=gpt-4.1-mini
